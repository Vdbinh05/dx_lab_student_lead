# Prisma CLI and local runtime only. Never point this at Turso production.
LOCAL_DATABASE_URL="file:./dev.db"

# Optional compatibility alias for existing local/Docker installations.
DATABASE_URL="file:./dev.db"

# Required together for Turso runtime. Store real values outside Git.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
APP_PORT=3000
TRAINING_VOLUME_NAME=dx_lab_sv1_training_data
